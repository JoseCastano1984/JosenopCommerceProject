@model CarouselModel

@{
    //page title
    ViewBag.PageTitle = "Edit Carousel";
    //active menu item (system name)
    Layout = "_AdminLayout";
}




<form asp-controller="CustomCarousel" asp-action="Edit" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            Edit Carousel - @Model.CarouselName
            <small>
                <i class="fa fa-arrow-circle-left"></i>
                <a asp-action="Configure">Back To Carousel List</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn bg-blue">
                <i class="fa fa-floppy-o"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn bg-blue">
                <i class="fa fa-floppy-o"></i>
                @T("Admin.Common.SaveContinue")
            </button>
            <span id="banner-delete" class="btn bg-red">
                <i class="fa fa-trash-o"></i>
                @T("Admin.Common.Delete")
            </span>

        </div>
    </div>
    @await Html.PartialAsync("_CreateOrUpdate.cshtml", Model)
</form>
<nop-delete-confirmation asp-model-id="@Model.Id" asp-button-id="banner-delete" />


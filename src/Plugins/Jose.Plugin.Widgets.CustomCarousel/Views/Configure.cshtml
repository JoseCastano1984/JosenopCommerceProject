@model CarouselSearchModel
@{
    Layout = "_ConfigurePlugin";
}

<form asp-controller="CustomCarousel" asp-action="Configure" method="post" id="carousels-form">
    <div class="cards-group">
        <div class="card card-default">
            <div class="card-body">
                @await Html.PartialAsync("Table", new DataTablesModel
                {
                   Name = "carousels-grid",
                   UrlRead = new DataUrl("List", "CustomCarousel", null),
                   UrlDelete = new DataUrl("Delete", "CustomCarousel", null),
                   Length = Model.PageSize,
                   LengthMenu = Model.AvailablePageSizes,
                   ColumnCollection = new List<ColumnProperty>
                    {
                        new ColumnProperty(nameof(CarouselModel.CarouselName))
                        {
                            Title = "Carousel name",
                            Width = "200"
                        },
                        new ColumnProperty(nameof(CarouselModel.StartDate))
                        {
                            Title = "Start date",
                            Width = "200",
                            Render = new RenderDate()
                        },
                        new ColumnProperty(nameof(CarouselModel.EndDate))
                        {
                            Title = "End date",
                            Width = "200",
                            Render = new RenderDate()
                        },
                        new ColumnProperty(nameof(CarouselModel.Published))
                        {
                            Title = "Published",
                            Width = "100",
                            ClassName = NopColumnClassDefaults.CenterAll,
                            Render = new RenderBoolean()
                        },
                        new ColumnProperty(nameof(CarouselModel.Id))
                        {
                            Title = "Edit",
                            ClassName = NopColumnClassDefaults.Button,
                            Width = "100",
                            Render = new RenderCustom("renderColumnEdit")
                        },
                        new ColumnProperty(nameof(CarouselModel.Id))
                        {
                            Title = "Delete",
                            ClassName = NopColumnClassDefaults.Button,
                            Render = new RenderButtonRemove("Delete"),
                            Width = "100"
                        }
                    }
                })
            </div>

            <script>
                function renderColumnEdit(data, type, row, meta) {
                    return '<button onclick=\"javascript:OpenWindow(\'@Url.Content("~/Admin/CustomCarousel/Edit/")' + data + '?btnId=btnRefresh&formId=carousels-form\', 800, 800, true); return false;\" class="btn btn-default"><i class="fas fa-pencil"></i>@T("Admin.Common.Edit").Text</button>';
                }
            </script>

            <div class="card-footer">
                <button type="submit" id="btnAddNewOption" name="save" class="btn btn-primary" onclick="javascript:OpenWindow('@(Url.Action("Create", "PickupInStore",  new { btnId = "btnRefresh", formId = "pickup-instore-form" }))', 800, 800, true); return false;">@T("Plugins.Pickup.PickupInStore.AddNew")</button>

                <button id="btnRefresh" type="submit" name="save" class="btn btn-default" style="display: none"></button>
            </div>
            <script>
                $(function() {
                    $('#btnRefresh').click(function () {
                        //refresh grid
                        updateTable('#carousels-grid');

                        //return false to don't reload a page
                        return false;
                    });
                });
            </script>
        </div>
    </div>
</form>
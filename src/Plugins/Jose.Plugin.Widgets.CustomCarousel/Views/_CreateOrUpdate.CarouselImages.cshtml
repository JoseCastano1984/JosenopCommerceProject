@model CarouselImageModel

@{
    if (Model.Id > 0)
    {
        <div class="card card-default">
            <div class="card-header">
                Add Carousel Images
            </div>
            <div class="card-body add-carousel-image">
                <script>
                    $(document).ready(function () {
                        $('#addCarouselImage').on('click', function () {
                            var carouselId = $('#@Html.IdFor(model => model.CarouselId)').val();
                            var pictureId = $('#@Html.IdFor(model => model.PictureId)').val();
                            var mobilePictureId = $('#@Html.IdFor(model => model.MobilePictureId)').val();
                            var link = $('#@Html.IdFor(model => model.Link)').val();
                            var displayOrder = $('#@Html.IdFor(model => model.DisplayOrder)').val();
                            var published = $('#@Html.IdFor(model => model.Published)').is(':checked');

                            $('#addCarouselImage').attr('disabled', true);
                            
                            var postData = {
                                carouselId: carouselId,
                                pictureId: pictureId,
                                mobilePictureId: mobilePictureId,
                                link: link, 
                                displayOrder: displayOrder,
                                published: published
                            };
                            addAntiForgeryToken(postData);
                            
                            $.ajax({
                                cache: false,
                                type: "POST",
                                url: "@(Url.Action("AddImageToCarousel", "CustomCarousel"))",
                                data: postData,
                                success: function (data) {
                                    if (!data.result) {
                                        return;
                                    }
                                }
                            })
                        })
                    })
                </script>
            </div>
        </div>
    }
}
@model CarouselModel

<div asp-validation-summary="All"></div>
<input asp-for="Id" type="hidden" />

@if (ViewBag.RefreshPage == true)
{
    <script>
        try {window.opener.document.forms['@(Context.Request.Query["formId"])'].@(Context.Request.Query["btnId"]).click();}
        catch (e){}
        window.close();
    </script>
}

<div class="cards-group">
    <div class="card card-default card-popup">
        <div class="card-body">
            <div class="form-group-row">
                <div class="col-sm-3">
                    <nop-label asp-for="CarouselName" />
                </div>
                <div class="col-sm-9">
                    <nop-editor asp-for="CarouselName" />
                    <span asp-validation-for="CarouselName"></span>
                </div>
            </div>
            <div class="form-group-row">
                <div class="col-sm-3">
                    <nop-label asp-for="StartDate" />
                </div>
                <div class="col-sm-9">
                    <nop-editor asp-for="StartDate" asp-required="true" />
                    <span asp-validation-for="StartDate"></span>
                </div>
            </div>
            <div class="form-group-row">
                <div class="col-sm-3">
                    <nop-label asp-for="Published" />
                </div>
                <div class="col-sm-9">
                    <nop-editor asp-for="Published" />
                    <span asp-validation-for="Published"></span>
                </div>
            </div>
        </div>
    </div>
    <div id="banner-carousel-image">
        <nop-panel asp-name="banner-fabrics" asp-icon="fa fa-picture-o" asp-title="Fabrics" asp-hide-block-attribute-name="BannerFabrics" asp-hide="false" asp-advanced="false">@await Html.PartialAsync("_CreateOrUpdate.CarouselImages.cshtml", Model)</nop-panel>
    </div>
</div>

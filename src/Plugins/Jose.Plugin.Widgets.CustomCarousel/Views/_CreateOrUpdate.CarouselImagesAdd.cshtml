@using Jose.Plugin.Widgets.CustomCarousel.Controllers
@using Microsoft.AspNetCore.Routing
@model CarouselModel

@{
    if (Model.Id > 0)
    {
        <div class="card card-default">
            <div class="card-header">
                Carousel Images
            </div>
            <div class="card-body">
                
                @await Html.PartialAsync("Table", new DataTablesModel
                {
                    Name = "carouselImages-grid",
                    UrlRead = new DataUrl("CarouselImagesList", "CustomCarousel", new RouteValueDictionary { [nameof(Model.Id)] = Model.Id }),
                    UrlDelete = new DataUrl("DeleteImageInCarousel", "CustomCarousel", routeValues: null),
                    Length = 15,
                    ColumnCollection = new List<ColumnProperty>
                    {
                        new ColumnProperty(nameof(CarouselImageModel.Id))
                        {
                            Title = "Image",
                            Render = new RenderCustom("renderImage"),
                            Width = "150"
                        },
                        new ColumnProperty(nameof(CarouselImageModel.Id))
                        {
                            Title = "Mobile Image",
                            Render = new RenderCustom("renderImageMobile"),
                            Width = "150"
                        },
                        new ColumnProperty(nameof(CarouselImageModel.Link))
                        {
                            Title = "Link",
                            Editable = true,
                            EditType = EditType.String
                        },
                        new ColumnProperty(nameof(CarouselImageModel.DisplayOrder))
                        {
                            Title = "Display Order",
                            Editable = true,
                            EditType = EditType.Number
                        },
                        new ColumnProperty(nameof(CarouselImageModel.Published))
                        {
                            Title = "Published",
                            Width = "100",
                            ClassName = NopColumnClassDefaults.CenterAll,
                            Render = new RenderBoolean()
                        },
                        new ColumnProperty(nameof(CarouselImageModel.Id))
                        {
                            Title = T("Admin.Common.Delete").Text,
                            Width = "100",
                            Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
                            ClassName = NopColumnClassDefaults.Button
                        }
                    }
    
                })

                <script>
                    function renderImage(data, type, row, meta) {
                        return '<img alt="' + row.PictureUrl + '" src="' + row.PictureUrl + '" width="100" />';
                    }

                    function renderImageMobile(data, type, row, meta) {
                        return '<img alt="' + row.MobilePictureUrl + '" src="' + row.MobilePictureUrl + '" width="100" />';
                    }
                </script>
                
            </div>
        </div>
        <div class="card card-default">
            <div class="card-header">
                Add carousel images
            </div>
            <div class="card-body add-carousel-image">
                <script>
                    $(document).ready(function () {
                        $('#addCarouselImage').on('click', function () {
                            var imageId = $('#@Html.IdFor(model => model.AddImageInCarousel.ImageId)').val();
                            var mobileImageId = $('#@Html.IdFor(model => model.AddImageInCarousel.MobileImageId)').val();
                            var link = $('#@Html.IdFor(model => model.AddImageInCarousel.Link)').val();
                            var displayOrder = $("#@Html.IdFor(model => model.AddImageInCarousel.DisplayOrder)").val();
                            var published = $('#@Html.IdFor(model => model.AddImageInCarousel.Published)').is(':checked');
                            var carouselId = $('#@Html.IdFor(model => model.Id)').val();

                            $('#addCarouselImage').attr('disabled', true);
                            
                            var postData = {
                                imageId: imageId,
                                mobileImageId: mobileImageId,
                                link: link,
                                displayOrder: displayOrder,
                                published: published,
                                carouselId: carouselId
                            };
                            addAntiForgeryToken(postData);
                            
                            $.ajax({
                                cache: false,
                                type: "POST",
                                url: "@(Url.Action("AddImageInCarousel", "CustomCarousel"))",
                                data: postData,
                                success: function (data, textStatus, jqXHR) {
                                    if (!data.Result) {
                                        return;
                                    }
                                    updateTable("#carouselImages-grid");
                                },
                                error: function (jqXHR, textStatus, errorThrown) {
                                    $("#CarouselAddAlert").click();
                                },
                                complete: function (jqXHR, textStatus) {
                                    $('#addCarouselImage').attr('disabled', false);
                                }
                            });
                            
                        });
                    });
                </script>
                <div class="form-group row picture-id">
                    <div class="col-md-3">
                        <nop-label asp-for="AddImageInCarousel.ImageId" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="AddImageInCarousel.ImageId" />
                        <span asp-validation-for="AddImageInCarousel.ImageId"></span>
                    </div>
                </div>
                <div class="form-group row picture-id">
                    <div class="col-md-3">
                        <nop-label asp-for="AddImageInCarousel.MobileImageId" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="AddImageInCarousel.MobileImageId" />
                        <span asp-validation-for="AddImageInCarousel.MobileImageId"></span>
                    </div>
                </div>
                <div class="form-group row picture-id">
                    <div class="col-md-3">
                        <nop-label asp-for="AddImageInCarousel.Link" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="AddImageInCarousel.Link" />
                        <span asp-validation-for="AddImageInCarousel.Link"></span>
                    </div>
                </div>
                <div class="form-group row picture-id">
                    <div class="col-md-3">
                        <nop-label asp-for="AddImageInCarousel.DisplayOrder" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="AddImageInCarousel.DisplayOrder" />
                        <span asp-validation-for="AddImageInCarousel.DisplayOrder"></span>
                    </div>
                </div>
                <div class="form-group row picture-id">
                    <div class="col-md-3">
                        <nop-label asp-for="AddImageInCarousel.Published" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="AddImageInCarousel.Published" />
                        <span asp-validation-for="AddImageInCarousel.Published"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-9 col-md-offset-3">
                        <button type="button" id="addCarouselImage" class="btn btn-primary">Add image to carousel</button>
                    </div>
                </div>
            </div>
        </div>
        
    }
    else
    {
        <div class="card card-default">
            <div class="card-header">
                Carousel Images
            </div>
            <div class="card-body">
                Save first
            </div>
        </div>
    }
}
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Nop.Web.Framework.Infrastructure
@model Jose.Plugin.Widgets.CustomCarousel.Areas.Admin.Models.CarouselModel

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    //page title
    ViewBag.PageTitle = "Add New Carousel";
}

<form asp-controller="CustomCarousel" asp-action="Create" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            Add New Carousel
            <small>
                <i class="fa fa-arrow-circle-left"></i>
                <a asp-action="List">Back To Carousel List</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.SaveContinue")
            </button>
            @await Component.InvokeAsync("AdminWidget", new { widgetZone = AdminWidgetZones.PollDetailsButtons })
        </div>
    </div>
    @await Html.PartialAsync("_CreateOrUpdate.cshtml", Model)
    
    
</form>